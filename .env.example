# Documentation example: export variables in your shell; no automatic .env loader.
# Synthetic data only. This draft refuses production/live settings.
HH_MODE=demo
HH_HOST=127.0.0.1
HH_PORT=8000
HH_DATA_DIR=var
HH_INTEGRATION=mock
HH_PHOTO_RETENTION_DAYS=7
HH_MAX_PHOTO_BYTES=4194304
HH_AI_PROVIDER=disabled
HH_OLLAMA_URL=http://127.0.0.1:11434
# An installed local model must be explicitly selected. No model is bundled.
HH_OLLAMA_MODEL=
