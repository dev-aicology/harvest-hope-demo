{
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HandoffCommand": {
        "additionalProperties": false,
        "properties": {
          "expected_version": {
            "minimum": 1.0,
            "title": "Expected Version",
            "type": "integer"
          },
          "idempotency_key": {
            "maxLength": 100,
            "minLength": 8,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Idempotency Key",
            "type": "string"
          }
        },
        "required": [
          "expected_version",
          "idempotency_key"
        ],
        "title": "HandoffCommand",
        "type": "object"
      },
      "Line": {
        "additionalProperties": false,
        "properties": {
          "barcode": {
            "default": "",
            "maxLength": 32,
            "title": "Barcode",
            "type": "string"
          },
          "checked": {
            "default": false,
            "title": "Checked",
            "type": "boolean"
          },
          "description": {
            "default": "",
            "maxLength": 300,
            "title": "Description",
            "type": "string"
          },
          "disposition": {
            "default": "available",
            "enum": [
              "available",
              "hold"
            ],
            "title": "Disposition",
            "type": "string"
          },
          "expiry_date": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiry Date"
          },
          "line_id": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+$",
            "title": "Line Id",
            "type": "string"
          },
          "lot": {
            "default": "",
            "maxLength": 120,
            "title": "Lot",
            "type": "string"
          },
          "measured_weight": {
            "anyOf": [
              {
                "maximum": 1000000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,3}0*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Measured Weight"
          },
          "product_id": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Id"
          },
          "quantity": {
            "anyOf": [
              {
                "maximum": 1000000.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d{0,3}0*$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          },
          "unit": {
            "anyOf": [
              {
                "enum": [
                  "case",
                  "each",
                  "lb",
                  "kg"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Unit"
          },
          "weight_unit": {
            "anyOf": [
              {
                "enum": [
                  "lb",
                  "kg"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Weight Unit"
          }
        },
        "title": "Line",
        "type": "object"
      },
      "ReceiptInput": {
        "additionalProperties": false,
        "properties": {
          "delivery_ref": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Delivery Ref",
            "type": "string"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/Line"
            },
            "maxItems": 100,
            "title": "Lines",
            "type": "array"
          },
          "notes": {
            "default": "",
            "maxLength": 2000,
            "title": "Notes",
            "type": "string"
          },
          "purchase_order_ref": {
            "default": "",
            "maxLength": 120,
            "title": "Purchase Order Ref",
            "type": "string"
          },
          "received_on": {
            "format": "date",
            "title": "Received On",
            "type": "string"
          },
          "supplier": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Supplier",
            "type": "string"
          },
          "warehouse": {
            "default": "DEMO-DOCK-1",
            "maxLength": 80,
            "minLength": 1,
            "title": "Warehouse",
            "type": "string"
          }
        },
        "required": [
          "supplier",
          "delivery_ref"
        ],
        "title": "ReceiptInput",
        "type": "object"
      },
      "ReceiptUpdate": {
        "additionalProperties": false,
        "properties": {
          "delivery_ref": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Delivery Ref",
            "type": "string"
          },
          "expected_version": {
            "minimum": 1.0,
            "title": "Expected Version",
            "type": "integer"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/Line"
            },
            "maxItems": 100,
            "title": "Lines",
            "type": "array"
          },
          "notes": {
            "default": "",
            "maxLength": 2000,
            "title": "Notes",
            "type": "string"
          },
          "purchase_order_ref": {
            "default": "",
            "maxLength": 120,
            "title": "Purchase Order Ref",
            "type": "string"
          },
          "received_on": {
            "format": "date",
            "title": "Received On",
            "type": "string"
          },
          "supplier": {
            "maxLength": 160,
            "minLength": 1,
            "title": "Supplier",
            "type": "string"
          },
          "warehouse": {
            "default": "DEMO-DOCK-1",
            "maxLength": 80,
            "minLength": 1,
            "title": "Warehouse",
            "type": "string"
          }
        },
        "required": [
          "supplier",
          "delivery_ref",
          "expected_version"
        ],
        "title": "ReceiptUpdate",
        "type": "object"
      },
      "ReconcileCommand": {
        "additionalProperties": false,
        "properties": {
          "expected_version": {
            "minimum": 1.0,
            "title": "Expected Version",
            "type": "integer"
          },
          "simulate_mismatch": {
            "default": false,
            "title": "Simulate Mismatch",
            "type": "boolean"
          }
        },
        "required": [
          "expected_version"
        ],
        "title": "ReconcileCommand",
        "type": "object"
      },
      "ReviewCommand": {
        "additionalProperties": false,
        "properties": {
          "expected_version": {
            "minimum": 1.0,
            "title": "Expected Version",
            "type": "integer"
          },
          "note": {
            "default": "",
            "maxLength": 1000,
            "title": "Note",
            "type": "string"
          }
        },
        "required": [
          "expected_version"
        ],
        "title": "ReviewCommand",
        "type": "object"
      },
      "SessionInput": {
        "additionalProperties": false,
        "properties": {
          "identity": {
            "enum": [
              "receiver",
              "reviewer"
            ],
            "title": "Identity",
            "type": "string"
          }
        },
        "required": [
          "identity"
        ],
        "title": "SessionInput",
        "type": "object"
      },
      "SuggestCommand": {
        "additionalProperties": false,
        "properties": {
          "barcode": {
            "default": "",
            "maxLength": 32,
            "title": "Barcode",
            "type": "string"
          },
          "expected_version": {
            "minimum": 1.0,
            "title": "Expected Version",
            "type": "integer"
          },
          "label_text": {
            "default": "",
            "maxLength": 2000,
            "title": "Label Text",
            "type": "string"
          },
          "line_id": {
            "maxLength": 80,
            "minLength": 1,
            "title": "Line Id",
            "type": "string"
          },
          "use_ai": {
            "default": false,
            "title": "Use Ai",
            "type": "boolean"
          }
        },
        "required": [
          "expected_version",
          "line_id"
        ],
        "title": "SuggestCommand",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VersionCommand": {
        "additionalProperties": false,
        "properties": {
          "expected_version": {
            "minimum": 1.0,
            "title": "Expected Version",
            "type": "integer"
          }
        },
        "required": [
          "expected_version"
        ],
        "title": "VersionCommand",
        "type": "object"
      }
    }
